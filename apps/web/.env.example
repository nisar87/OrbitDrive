# Values prefixed VITE_ are PUBLIC: they are embedded in the web bundle. Never put secrets here.
# Origin of the dedicated OrbitDrive relay (NOT a Firebase Hosting rewrite: Hosting times out after 60 s).
VITE_GATEWAY_URL=https://relay.example.invalid
# "firebase" for real builds. "dev" works only with a Development gateway and is rejected by production builds.
VITE_AUTH_MODE=firebase
# Firebase web configuration (public identifiers from Project settings → Your apps → Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orbitdrive-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orbitdrive-dev
VITE_FIREBASE_APP_ID=
