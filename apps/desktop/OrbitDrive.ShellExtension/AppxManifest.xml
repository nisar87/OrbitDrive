<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package: gives the OrbitDrive desktop app a package identity WITHOUT moving its files, which is what lets the command appear in the
  Windows 11 modern context menu. The identity Publisher must match the signing certificate; the value below is a development placeholder.
  A production build needs the owner's code-signing identity (see docs/operations/windows-shell.md). Nothing here is signed or published.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="OrbitDrive.Desktop.Dev" Publisher="CN=OrbitDrive Development" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>OrbitDrive (development identity)</DisplayName>
    <PublisherDisplayName>OrbitDrive</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="OrbitDrive" Executable="OrbitDrive.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="OrbitDrive" Description="Send files to your phone" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="OrbitDriveSend" Clsid="7B2C3E8A-5D41-4C6F-9A07-1E3B5F9D2C64" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="OrbitDrive Explorer command">
              <com:Class Id="7B2C3E8A-5D41-4C6F-9A07-1E3B5F9D2C64" Path="OrbitDriveShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
