<Window x:Class="OrbitDrive.Desktop.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        AllowsTransparency="False" AutomationProperties.Name="OrbitDrive quick menu">
    <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Text.Strong}" AutomationProperties.AutomationId="FlyoutTitle"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="FlyoutDetail"/>
            <Button Content="Open OrbitDrive" Command="{Binding OpenCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource Size.TouchTarget}" Margin="0,0,0,8" AutomationProperties.AutomationId="FlyoutOpen"/>
            <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" IsEnabled="{Binding CanTogglePause}" HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource Size.TouchTarget}" Margin="0,0,0,8" AutomationProperties.AutomationId="FlyoutPause"/>
            <Button Content="Quit OrbitDrive (stops remote access)" Command="{Binding QuitCommand}" HorizontalAlignment="Stretch"
                    MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="FlyoutQuit"/>
        </StackPanel>
    </Border>
</Window>
