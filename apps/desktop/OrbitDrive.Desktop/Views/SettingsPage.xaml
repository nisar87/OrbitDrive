<UserControl x:Class="OrbitDrive.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrbitDrive.Desktop.Views"
             IsTabStop="False" Focusable="False">
    <StackPanel MaxWidth="{StaticResource Page.MaxWidth}">
        <TextBlock Text="Settings" Style="{StaticResource Style.Text.PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Text="How MyOrbitDrive starts, sends files and connects. Changes to switches and limits apply straight away." Style="{StaticResource Style.Text.PageIntro}"
                   AutomationProperties.AutomationId="SettingsIntro" Margin="0,0,0,8"/>
        <TabControl x:Name="Tabs" AutomationProperties.AutomationId="SettingsTabs" AutomationProperties.Name="Settings sections" Margin="0,0,0,0">
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="General" AutomationProperties.AutomationId="SettingsTab_General" AutomationProperties.Name="General">
                <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <CheckBox Content="Start MyOrbitDrive when I sign in to Windows" IsChecked="{Binding StartAtSignIn, Mode=TwoWay}" AutomationProperties.AutomationId="StartAtSignIn"/>
                        <TextBlock Text="It starts quietly in the notification area, as you, without administrator rights. Off unless you turn it on." Style="{StaticResource Style.Text.Muted}" Margin="28,0,0,12"/>
                        <CheckBox Content="Pause remote access while this PC is locked" IsChecked="{Binding PauseWhenLocked, Mode=TwoWay}" AutomationProperties.AutomationId="PauseWhenLocked"/>
                        <TextBlock Text="Otherwise MyOrbitDrive keeps working while the PC is locked. When the PC sleeps, shuts down or you sign out, your phone cannot reach it. MyOrbitDrive never changes your sleep settings or keeps the PC awake."
                                   Style="{StaticResource Style.Text.Muted}" Margin="28,0,0,0"/>
                        <TextBlock Text="{Binding SettingsError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="GeneralError"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Name of this PC, as your phone and browser show it" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Width="320" HorizontalAlignment="Left" AutomationProperties.AutomationId="PcNameBox"
                                 AutomationProperties.Name="PC name" Margin="0,0,0,12"/>
                        <Button Content="Save name" Command="{Binding SavePcNameCommand}" HorizontalAlignment="Left" Padding="{StaticResource Inset.Button}"
                                MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="SavePcNameButton"/>
                        <TextBlock Text="{Binding PcNameError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="PcNameError"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Quit MyOrbitDrive" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="Closing this window keeps MyOrbitDrive running in the notification area, so your phone can still reach your shared folders. Quit stops all sharing until you open MyOrbitDrive again."
                                   Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,10" AutomationProperties.AutomationId="CloseHint"/>
                        <Button Content="Quit MyOrbitDrive" Command="{Binding QuitCommand}" HorizontalAlignment="Left" Padding="{StaticResource Inset.Button}"
                                MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="QuitButton"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </TabItem>
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="Sending" AutomationProperties.AutomationId="SettingsTab_Sending" AutomationProperties.Name="Sending">
                <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Sending files" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="Top speed for all files together, in KB/s (0 means no limit)" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MaxSpeed, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="MaxSpeedBox"
                                 AutomationProperties.Name="Upload speed limit in kilobytes per second" Margin="0,0,0,12"/>
                        <TextBlock Text="Files sent at the same time (1–16)" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding MaxFiles, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" AutomationProperties.AutomationId="MaxFilesBox"
                                 AutomationProperties.Name="Files sent at the same time" Margin="0,0,0,12"/>
                        <Button Content="Save limits" Command="{Binding SaveLimitsCommand}" HorizontalAlignment="Left" Padding="{StaticResource Inset.Button}"
                                MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="SaveLimitsButton"/>
                        <TextBlock Text="{Binding LimitsError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="LimitsError"/>
                        <CheckBox Content="Pause remote access while this PC is on a metered connection" IsChecked="{Binding PauseOnMetered, Mode=TwoWay}" Margin="0,14,0,0"
                                  AutomationProperties.AutomationId="PauseOnMetered"/>
                        <TextBlock Text="Windows marks mobile hotspots and some other connections as metered. MyOrbitDrive shows a warning on such a connection. Tick the box to stop sending until the connection is no longer metered."
                                   Style="{StaticResource Style.Text.Muted}" Margin="28,0,0,0"/>
                        <TextBlock Text="{Binding SettingsError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="SendingError"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Picture previews" Style="{StaticResource Style.Text.Section}"/>
                        <CheckBox Content="Show small previews of pictures to my paired devices" IsChecked="{Binding ThumbnailsEnabled, Mode=TwoWay}" IsEnabled="{Binding ThumbnailsAvailable}"
                                  AutomationProperties.AutomationId="ThumbnailsToggle"/>
                        <TextBlock Text="{Binding ThumbnailStatus}" Style="{StaticResource Style.Text.Muted}" Margin="28,2,0,10" AutomationProperties.AutomationId="ThumbnailStatus"/>
                        <Button Content="Delete stored previews" Command="{Binding ClearThumbnailsCommand}" IsEnabled="{Binding CanClearThumbnails}" HorizontalAlignment="Left"
                                Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="ClearThumbnailsButton"/>
                        <TextBlock Text="{Binding ThumbnailError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="ThumbnailError"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Send to phone from Explorer" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="Adds your paired devices to the Send to menu in File Explorer, so you can right-click a file and send it to your phone. This window can't tell whether it is on right now, so choose what you want."
                                   Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Turn on" Command="{Binding SendToOnCommand}" Padding="{StaticResource Inset.Button}" Margin="0,0,8,0" MinHeight="{StaticResource Size.TouchTarget}"
                                    AutomationProperties.AutomationId="SendToOnButton"/>
                            <Button Content="Turn off" Command="{Binding SendToOffCommand}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}"
                                    AutomationProperties.AutomationId="SendToOffButton"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SendToStatus}" Style="{StaticResource Style.Text.Base}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="SendToStatus"/>
                        <TextBlock Text="{Binding SendToError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="SendToError"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </TabItem>
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="Privacy" AutomationProperties.AutomationId="SettingsTab_Privacy" AutomationProperties.Name="Privacy">
                <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding PrivacyHeadline}" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="{Binding PrivacyBody}" Style="{StaticResource Style.Text.Base}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="PrivacyNote"/>
                        <TextBlock Text="{Binding PrivacyOnThisPc}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </TabItem>
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="Connection" AutomationProperties.AutomationId="SettingsTab_Connection" AutomationProperties.Name="Connection">
                <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="The relay is the MyOrbitDrive server that passes files between this PC and your devices. Its address is built into this copy of MyOrbitDrive and cannot be changed here. You can read it under Diagnostics." Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="RelayFixedNote"/>
                        <TextBlock Text="Web app address used in pairing links (optional, leave empty unless you were told to set it)" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WebOrigin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WebOriginBox" AutomationProperties.Name="Web app address" Margin="0,0,0,12"/>
                        <Button Content="Save web app address" Command="{Binding SaveGatewayCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"
                                Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="SaveGatewayButton"/>
                        <TextBlock Text="{Binding SettingsError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsError"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </TabItem>
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="Updates" AutomationProperties.AutomationId="SettingsTab_Updates" AutomationProperties.Name="Updates">
                <StackPanel Margin="0,12,0,0">
                <local:UpdateCard DataContext="{Binding Updates}"/>
                </StackPanel>
            </TabItem>
            <TabItem Padding="14,8" MinHeight="{StaticResource Size.TouchTarget}" Header="Diagnostics" AutomationProperties.AutomationId="SettingsTab_Diagnostics" AutomationProperties.Name="Diagnostics">
                <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource Style.Text.Section}"/>
                        <TextBlock Text="Relay address (read-only)" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Gateway, Mode=OneWay}" Style="{StaticResource Style.Text.Base}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.AutomationId="RelayAddressText" AutomationProperties.Name="Relay address, read-only"/>
                        <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource Style.Text.Base}" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsText"/>
                        <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="{StaticResource Inset.Button}"
                                MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="CopyDiagnosticsButton"/>
                        <TextBlock Text="{Binding SettingsError}" Style="{StaticResource Style.Text.Error}" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsError"/>
                    </StackPanel>
                </Border>

                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
