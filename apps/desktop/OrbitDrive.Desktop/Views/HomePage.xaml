<UserControl x:Class="OrbitDrive.Desktop.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OrbitDrive.Desktop.Controls"
             xmlns:local="clr-namespace:OrbitDrive.Desktop.Views"
             xmlns:vm="clr-namespace:OrbitDrive.Desktop.ViewModels"
             IsTabStop="False" Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InvertedBoolToVisibility x:Key="InvertedBool"/>
        <Style x:Key="Style.Glyph.Status" TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Icon}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Neutral}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Good"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Good}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Critical"><Setter Property="Foreground" Value="{StaticResource Brush.Status.Critical}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="{StaticResource Page.MaxWidth}">
        <TextBlock Text="Home" Style="{StaticResource Style.Text.PageTitle}" AutomationProperties.HeadingLevel="Level1"/>

        <!-- 1. Is sharing on, paused or broken, and the one button that fixes it. -->
        <Border Style="{StaticResource Style.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" Style="{StaticResource Style.Glyph.Status}" VerticalAlignment="Top" Margin="0,3,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="StateText"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Style.Text.Muted}" Margin="0,4,0,0" AutomationProperties.AutomationId="StateDetail"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Pause sharing" Command="{Binding PauseCommand}" Visibility="{Binding ShowPause, Converter={StaticResource BoolToVisibility}}"
                            Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="PauseButton"/>
                    <Button Content="Resume sharing" Command="{Binding ResumeCommand}" Visibility="{Binding ShowResume, Converter={StaticResource BoolToVisibility}}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="PauseButton"/>
                    <Button Content="Start OrbitDrive" Command="{Binding StartCommand}" Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="StartAgentButton"/>
                    <Button Content="Set up connection" Command="{Binding SetUpCommand}" Visibility="{Binding ShowSetUp, Converter={StaticResource BoolToVisibility}}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="SetUpConnectionButton"/>
                    <Button Content="Open updates" Command="{Binding OpenUpdatesCommand}" Visibility="{Binding ShowUpdates, Converter={StaticResource BoolToVisibility}}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="OpenUpdatesButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Things that need the owner's attention. -->
        <c:InfoBar Severity="Warning" Title="A device wants to connect" Message="{Binding ApprovalMessage}" ActionText="Review" ActionCommand="{Binding ReviewApprovalCommand}"
                   ActionAutomationId="ReviewApprovalButton" Visibility="{Binding ShowApproval, Converter={StaticResource BoolToVisibility}}"/>
        <c:InfoBar Severity="Info" Title="An update is ready" Message="{Binding UpdateMessage}" ActionText="Open Settings" ActionCommand="{Binding OpenUpdatesCommand}"
                   ActionAutomationId="UpdateReadyButton" Visibility="{Binding ShowUpdateBar, Converter={StaticResource BoolToVisibility}}"/>
        <c:InfoBar Severity="Warning" Title="This PC is on a metered connection" Message="{Binding MeteredMessage}"
                   Visibility="{Binding ShowMetered, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 2. First run: a folder shared and a device paired, in that order. Shown only while a step is open. -->
        <Border Style="{StaticResource Style.Card}" Visibility="{Binding ShowGetStarted, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="GetStartedCard" AutomationProperties.Name="Get started">
            <StackPanel>
                <TextBlock Text="Get started" Style="{StaticResource Style.Text.Section}" Margin="0,0,0,2"/>
                <TextBlock Text="Two steps, about a minute, and your phone can open your files." Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1" Style="{StaticResource Style.Text.Strong}" VerticalAlignment="Center" Visibility="{Binding Step1Next, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Column="0" Text="&#xE73E;" Style="{StaticResource Style.Text.Icon}" Foreground="{StaticResource Brush.Status.Good}"
                               Visibility="{Binding Step1Done, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Choose a folder to share" Style="{StaticResource Style.Text.Strong}"/>
                        <TextBlock Text="Only folders you pick are visible to your devices. They can look and download, nothing more." Style="{StaticResource Style.Text.Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Share a folder" Command="{Binding ShareFolderCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="16,0,0,0"
                            Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" Visibility="{Binding Step1Next, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="GetStartedShareButton"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="2" Style="{StaticResource Style.Text.Strong}" VerticalAlignment="Center" Visibility="{Binding Step2Done, Converter={StaticResource InvertedBool}}"/>
                    <TextBlock Grid.Column="0" Text="&#xE73E;" Style="{StaticResource Style.Text.Icon}" Foreground="{StaticResource Brush.Status.Good}"
                               Visibility="{Binding Step2Done, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Pair your phone or browser" Style="{StaticResource Style.Text.Strong}"/>
                        <TextBlock Text="Scan a code on this screen, then approve the request here." Style="{StaticResource Style.Text.Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Pair a device" Command="{Binding PairCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="16,0,0,0"
                            Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" Visibility="{Binding Step2Next, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="GetStartedPairButton"/>
                    <Button Grid.Column="2" Content="Pair a device" Command="{Binding PairCommand}" Margin="16,0,0,0"
                            Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" Visibility="{Binding Step2Later, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="GetStartedPairLaterButton"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. At a glance. -->
        <UniformGrid Columns="2" Margin="0,0,-12,16">
            <Button Command="{Binding OpenFoldersCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14,20,14" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="FoldersTile" AutomationProperties.Name="{Binding FoldersTileName}">
                <StackPanel>
                    <TextBlock Text="{Binding FoldersTile}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.Stat}" FontWeight="SemiBold"/>
                    <TextBlock Text="Shared folders" Style="{StaticResource Style.Text.Muted}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenDevicesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20,14,20,14" Margin="0,0,12,0"
                    AutomationProperties.AutomationId="DevicesTile" AutomationProperties.Name="{Binding DevicesTileName}">
                <StackPanel>
                    <TextBlock Text="{Binding DevicesTile}" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource FontSize.Stat}" FontWeight="SemiBold"/>
                    <TextBlock Text="Paired devices" Style="{StaticResource Style.Text.Muted}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- 4. Live transfers, only while something is being sent. -->
        <Border Style="{StaticResource Style.Card}" Visibility="{Binding HasActiveTransfers, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="SendingNowCard">
            <StackPanel>
                <TextBlock Text="Sending now" Style="{StaticResource Style.Text.Section}"/>
                <ItemsControl ItemsSource="{Binding ActiveTransfers}" Focusable="False" AutomationProperties.AutomationId="SendingNowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TransferItem}">
                            <StackPanel Margin="0,0,0,12" AutomationProperties.Name="{Binding Summary}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Style.Text.Strong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Height="4" Margin="0,6,0,4"
                                             AutomationProperties.Name="{Binding Summary}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Style.Text.Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="OrbitDrive can see what it has sent to the relay. It cannot see whether a browser finished saving a file." Style="{StaticResource Style.Text.Muted}"/>
            </StackPanel>
        </Border>

        <!-- 5. What happened lately: kinds of events, counts and sizes only. -->
        <Border Style="{StaticResource Style.Card}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Recent activity" Style="{StaticResource Style.Text.Section}" Margin="0" VerticalAlignment="Center"/>
                    <Button Content="See all activity" Command="{Binding SeeAllActivityCommand}" HorizontalAlignment="Right" Padding="12,5,12,5"
                            AutomationProperties.AutomationId="SeeAllActivityButton"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Recent}" Focusable="False" AutomationProperties.AutomationId="HomeRecentList"
                              Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ActivityItem}">
                            <Grid Margin="0,6,0,6" AutomationProperties.Name="{Binding Summary}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Icon}">
                                            <Setter Property="Text" Value="&#xE81C;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Critical}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Text.Strong}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Style.Text.Muted}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <c:EmptyState Glyph="&#xE81C;" Title="Nothing has happened yet" Message="When a device connects or a file is sent, it shows up here."
                              Visibility="{Binding NoRecent, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
