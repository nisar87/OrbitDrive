<UserControl x:Class="OrbitDrive.Desktop.Views.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OrbitDrive.Desktop.Controls"
             xmlns:vm="clr-namespace:OrbitDrive.Desktop.ViewModels"
             IsTabStop="False" Focusable="False" AllowDrop="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Style.FolderItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="{StaticResource Page.MaxWidth}">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Shared folders" Style="{StaticResource Style.Text.PageTitle}" AutomationProperties.HeadingLevel="Level1" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Share a folder…" Command="{Binding ShareFolderCommand}" Style="{DynamicResource AccentButtonStyle}"
                    Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="ShareFolderButton"/>
        </Grid>
        <TextBlock Text="Only folders listed here can be seen from your paired devices. They can look and download, nothing more, unless you allow adding files to a folder. Windows permissions still apply. You can also drag a folder onto this page."
                   Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,16" AutomationProperties.AutomationId="RootsIntro"/>

        <Border Style="{StaticResource Style.Card}">
            <StackPanel>
                <TextBlock Text="Shared now" Style="{StaticResource Style.Text.Section}"/>
                <c:EmptyState Glyph="&#xE8B7;" Title="Nothing is shared yet" TitleAutomationId="RootsEmpty"
                              Message="Your files stay private until you pick a folder. Drag one here, or use Share a folder."
                              Visibility="{Binding NoFolders, Converter={StaticResource BoolToVisibility}}"/>
                <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource Style.FolderItem}"
                         Visibility="{Binding HasFolders, Converter={StaticResource BoolToVisibility}}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="RootsList"
                         AutomationProperties.Name="Shared folders">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FolderItem}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Style.Text.Icon}" FontSize="22" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Style.Text.Strong}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <c:StatusPill Grid.Column="2" Text="{Binding PillText}" Glyph="{Binding PillGlyph}" Kind="{Binding PillKind}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE783;" Style="{StaticResource Style.Text.Icon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Style.Text.Base}" TextWrapping="Wrap" AutomationProperties.AutomationId="RootError"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Style.Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedHeading}" Style="{StaticResource Style.Text.Section}"/>
                <WrapPanel>
                    <Button Content="{Binding UploadsActionText}" Command="{Binding ToggleUploadsCommand}" Padding="{StaticResource Inset.Button}" Margin="0,0,8,8"
                            MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="ToggleUploadsButton"/>
                    <Button Content="{Binding HiddenActionText}" Command="{Binding ToggleHiddenCommand}" Padding="{StaticResource Inset.Button}" Margin="0,0,8,8"
                            MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="ToggleHiddenButton"/>
                    <Button Content="Stop sharing this folder" Command="{Binding RemoveCommand}" Padding="{StaticResource Inset.Button}" Margin="0,0,8,8"
                            MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="RemoveRootButton"/>
                </WrapPanel>
                <TextBlock Text="Windows system files are never shared. A folder is tied to the disk it is on: another disk at the same drive letter is not shared."
                           Style="{StaticResource Style.Text.Muted}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Style.Card}">
            <StackPanel>
                <TextBlock Text="Share by typing a path" Style="{StaticResource Style.Text.Section}"/>
                <TextBlock Text="Name shown on your phone" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RootName" AutomationProperties.Name="Name shown on your phone" Margin="0,0,0,12"/>
                <TextBlock Text="Folder" Style="{StaticResource Style.Text.Muted}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RootPath" AutomationProperties.Name="Folder path" Margin="0,0,0,12"/>
                <CheckBox Content="Also share hidden files and folders from this folder" IsChecked="{Binding IncludeHidden}" AutomationProperties.AutomationId="NewRootHidden" Margin="0,0,0,12"/>
                <Button Content="Share this folder" Command="{Binding AddByPathCommand}" HorizontalAlignment="Left" Padding="{StaticResource Inset.Button}"
                        MinHeight="{StaticResource Size.TouchTarget}" AutomationProperties.AutomationId="AddRootButton"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
