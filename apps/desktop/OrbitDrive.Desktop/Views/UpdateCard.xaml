<UserControl x:Class="OrbitDrive.Desktop.Views.UpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False" Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Border Style="{StaticResource Style.Card}">
        <StackPanel>
            <TextBlock Text="Software updates" Style="{StaticResource Style.Text.Section}"/>
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Style.Text.Strong}" AutomationProperties.AutomationId="UpdateVersion"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Style.Text.Base}" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateStatus"/>
            <TextBlock Text="{Binding Notes}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateNotes"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Check for updates" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}" Padding="{StaticResource Inset.Button}"
                        MinHeight="{StaticResource Size.TouchTarget}" Margin="0,0,8,0" AutomationProperties.AutomationId="CheckUpdateButton"/>
                <Button Content="Update now" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}"
                        Style="{DynamicResource AccentButtonStyle}" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}"
                        AutomationProperties.AutomationId="InstallUpdateButton"/>
            </StackPanel>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Style.Text.Muted}" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateHint"/>
        </StackPanel>
    </Border>
</UserControl>
