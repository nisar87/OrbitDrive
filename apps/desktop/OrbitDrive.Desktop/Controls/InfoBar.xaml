<UserControl x:Class="OrbitDrive.Desktop.Controls.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsTabStop="False" Focusable="False" AutomationProperties.LiveSetting="Polite">
    <!-- A message that needs the owner's attention, with at most one action. Severity is carried by a glyph and the title, never by colour alone. -->
    <Border BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="16,12,16,12" Margin="{StaticResource Gap.Section}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Success">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Error">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,2,12,0" VerticalAlignment="Top" Text="{Binding Glyph, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Icon}">
                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Severity, ElementName=Root}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Style.Text.Strong}" Text="{Binding Title, ElementName=Root}"/>
                <TextBlock x:Name="MessageText" Style="{StaticResource Style.Text.Base}" Text="{Binding Message, ElementName=Root}"/>
            </StackPanel>
            <Button x:Name="ActionButton" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MinHeight="{StaticResource Size.TouchTarget}"
                    Padding="{StaticResource Inset.Button}" Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}"
                    AutomationProperties.AutomationId="{Binding ActionAutomationId, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
