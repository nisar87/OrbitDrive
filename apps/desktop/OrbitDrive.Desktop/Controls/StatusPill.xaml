<UserControl x:Class="OrbitDrive.Desktop.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsTabStop="False" Focusable="False" HorizontalAlignment="Left"
             AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}">
    <!-- A short status: a glyph AND a word on a tinted pill, so the meaning never depends on colour alone. -->
    <Border CornerRadius="{StaticResource Radius.Pill}" Padding="{StaticResource Inset.Pill}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Good"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Warning"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Critical"><Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph, ElementName=Root}" Margin="0,0,6,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Text.Icon}">
                        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorNeutralBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Text, ElementName=Root}" Style="{StaticResource Style.Text.Pill}" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
