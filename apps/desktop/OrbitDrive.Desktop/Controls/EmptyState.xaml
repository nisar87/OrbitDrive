<UserControl x:Class="OrbitDrive.Desktop.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsTabStop="False" Focusable="False">
    <!-- What a list shows when it has nothing yet: say why, and offer the one next step. Never a blank panel. -->
    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24" MaxWidth="420">
        <TextBlock Text="{Binding Glyph, ElementName=Root}" Style="{StaticResource Style.Text.Icon}" FontSize="32" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="{StaticResource Opacity.Muted}" Margin="0,0,0,12"/>
        <TextBlock x:Name="TitleText" Text="{Binding Title, ElementName=Root}" Style="{StaticResource Style.Text.Strong}" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="MessageText" Text="{Binding Message, ElementName=Root}" Style="{StaticResource Style.Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
        <Button x:Name="ActionButton" Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}" HorizontalAlignment="Center"
                Margin="0,16,0,0" Padding="{StaticResource Inset.Button}" MinHeight="{StaticResource Size.TouchTarget}"
                AutomationProperties.AutomationId="{Binding ActionAutomationId, ElementName=Root}"/>
    </StackPanel>
</UserControl>
