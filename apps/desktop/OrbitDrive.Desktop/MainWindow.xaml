<Window x:Class="OrbitDrive.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrbitDrive.Desktop"
        xmlns:vm="clr-namespace:OrbitDrive.Desktop.ViewModels"
        Title="OrbitDrive" Width="980" Height="680" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Text}" UseLayoutRounding="True"
        AutomationProperties.AutomationId="OrbitDriveMainWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- TRANSITIONAL: a page not yet rebuilt is shown as it was. -->
        <DataTemplate DataType="{x:Type vm:LegacyPageViewModel}">
            <ContentPresenter Content="{Binding View}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavColumnWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="8,16,8,16" BorderThickness="0,0,1,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,18">
                    <Image Source="{x:Static local:AppIcon.Image}" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="OrbitDrive" FontSize="{StaticResource FontSize.Lead}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Visibility="{Binding ShowLabels, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <ListBox x:Name="Nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         BorderThickness="0" Background="Transparent" FontSize="{StaticResource FontSize.Body}"
                         ItemContainerStyle="{StaticResource Style.NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="Navigation" AutomationProperties.Name="Sections">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Style.Text.Icon}" Width="30"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="{Binding PagePadding}">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" IsTabStop="False"/>
        </ScrollViewer>
    </Grid>
</Window>
