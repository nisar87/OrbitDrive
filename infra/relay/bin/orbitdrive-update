#!/usr/bin/env bash
# OrbitDrive relay updater (pull-based deployment).
# The server polls this repository's public GitHub Releases over HTTPS: no inbound access, no SSH and no
# credentials are needed on either side. A release is installed only if its checksum matches, and kept only
# if the running gateway then reports exactly that version; otherwise the previous release is restored.
# ENFORCED always: a release whose version is LOWER than the running one is refused (no downgrade).
# ENFORCED ONLY WHEN A KEY IS PRESENT: if the host has a release-signing public key (ORBIT_SIGNING_KEY, default
# /etc/orbitdrive/release-signing.pub), the release must carry a detached signature (gateway-<v>.tar.gz.sig, ECDSA P-256 / SHA-256)
# that verifies against it. With no key on the host, only the checksum is checked (integrity, not authenticity) and each install says so in the log.
# Create the key and sign with scripts/relay-sign.mjs; see docs/operations/relay.md.
set -euo pipefail
ROOT=${ORBIT_ROOT:-/opt/orbitdrive}
API=${ORBIT_API:-https://api.github.com/repos/nisar87/OrbitDrive}
CHANNEL=${ORBIT_CHANNEL:-dev}
HEALTH=${ORBIT_HEALTH_URL:-http://127.0.0.1:8080}
RESTART=${ORBIT_RESTART_CMD:-systemctl restart orbitdrive-gateway}
LOG=${ORBIT_DEPLOY_LOG:-/var/log/orbitdrive/deploy.log}
MAX_DISK=${ORBIT_MAX_DISK_PCT:-90}
SIGNING_KEY=${ORBIT_SIGNING_KEY:-/etc/orbitdrive/release-signing.pub}
TRIES=${ORBIT_HEALTH_TRIES:-30}
mkdir -p "$ROOT/releases" "$(dirname "$LOG")"
exec 9>"$ROOT/.update.lock"
flock -n 9 || exit 0   # one update at a time

audit() { printf '{"time":"%s","action":"%s","version":"%s","previous":"%s","detail":"%s"}\n' "$(date -u +%FT%TZ)" "$1" "${2:-}" "${3:-}" "${4:-}" >>"$LOG"; }
current() { [ -L "$ROOT/current" ] && basename "$(readlink "$ROOT/current")" || true; }
healthy() { # $1 = version the gateway must report
  for _ in $(seq "$TRIES"); do
    [ "$(curl -fsS -m 5 "$HEALTH/v1/meta" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)" = "$1" ] && return 0
    sleep 2
  done
  return 1
}

releases=$(curl -fsS -m 30 -H 'Accept: application/vnd.github+json' "$API/releases?per_page=30")
tag=$(jq -r --arg p "relay-$CHANNEL-" '[.[] | select(.draft|not) | select(.tag_name|startswith($p))][0].tag_name // empty' <<<"$releases")
[ -n "$tag" ] || exit 0
version=${tag#relay-"$CHANNEL"-}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { audit refused "$version" "" "invalid version in tag"; exit 1; }
previous=$(current)
[ "$version" = "$previous" ] && exit 0
# Never go backwards: an old release re-published (or served by a hostile mirror) cannot replace a newer one. Noted once per version, then ignored.
if [ -n "$previous" ] && [ "$(printf '%s\n%s\n' "$version" "$previous" | sort -V | head -n1)" = "$version" ]; then
  grep -qxF "$version" "$ROOT/refused-versions" 2>/dev/null || { echo "$version" >>"$ROOT/refused-versions"; audit refused "$version" "$previous" "version is lower than the running release"; }
  exit 0
fi
grep -qxF "$version" "$ROOT/bad-versions" 2>/dev/null && exit 0   # already tried and rolled back

used=$(df --output=pcent "$ROOT" | tail -1 | tr -dc 0-9)
[ "$used" -lt "$MAX_DISK" ] || { audit refused "$version" "$previous" "disk ${used}% used"; exit 1; }

asset() { jq -r --arg t "$tag" --arg n "$1" '.[] | select(.tag_name==$t) | .assets[] | select(.name==$n) | .browser_download_url' <<<"$releases"; }
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
tar_url=$(asset "gateway-$version.tar.gz"); sum_url=$(asset "gateway-$version.tar.gz.sha256")
[ -n "$tar_url" ] && [ -n "$sum_url" ] || { audit refused "$version" "$previous" "release assets missing"; exit 1; }
curl -fsSL -m 300 -o "$work/gateway-$version.tar.gz" "$tar_url"
curl -fsSL -m 60 -o "$work/gateway-$version.tar.gz.sha256" "$sum_url"
(cd "$work" && sha256sum -c "gateway-$version.tar.gz.sha256" >/dev/null) || { audit refused "$version" "$previous" "checksum mismatch"; exit 1; }
signature_note="checksum only: no signing key on this host"
if [ -s "$SIGNING_KEY" ]; then
  sig_url=$(asset "gateway-$version.tar.gz.sig")
  [ -n "$sig_url" ] || { audit refused "$version" "$previous" "release is not signed but this host requires signed releases"; exit 1; }
  curl -fsSL -m 60 -o "$work/gateway-$version.tar.gz.sig" "$sig_url"
  openssl dgst -sha256 -verify "$SIGNING_KEY" -signature "$work/gateway-$version.tar.gz.sig" "$work/gateway-$version.tar.gz" >/dev/null 2>&1 \
    || { audit refused "$version" "$previous" "signature does not verify"; exit 1; }
  signature_note="signature verified"
fi

target="$ROOT/releases/$version"
rm -rf "$target.tmp" && mkdir -p "$target.tmp"
tar -xzf "$work/gateway-$version.tar.gz" -C "$target.tmp" --no-same-owner
[ -f "$target.tmp/OrbitDrive.Gateway.dll" ] || { rm -rf "$target.tmp"; audit refused "$version" "$previous" "archive has no gateway"; exit 1; }
rm -rf "$target" && mv "$target.tmp" "$target"

switch() { ln -sfn "$ROOT/releases/$1" "$ROOT/current.new" && mv -T "$ROOT/current.new" "$ROOT/current"; $RESTART 9>&-; }   # never let the service inherit the update lock
switch "$version"
if healthy "$version"; then
  audit deployed "$version" "$previous" "health check passed; $signature_note"
  # keep the three newest releases plus whatever is current
  ls -1t "$ROOT/releases" | tail -n +4 | while read -r old; do [ "$old" = "$version" ] || rm -rf "$ROOT/releases/${old:?}"; done
  exit 0
fi
echo "$version" >>"$ROOT/bad-versions"
if [ -n "$previous" ] && [ -d "$ROOT/releases/$previous" ]; then
  switch "$previous"
  if healthy "$previous"; then audit rolled_back "$version" "$previous" "new release failed health check; previous restored"
  else audit rollback_failed "$version" "$previous" "previous release is not healthy either"; fi
else
  audit failed "$version" "" "first release failed health check; nothing to roll back to"
fi
exit 2
