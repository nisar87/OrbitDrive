#!/usr/bin/env bash
# Lightweight host monitor: one JSON status file, no agents. The public copy contains no secrets, paths or user data.
set -euo pipefail
STATE=${ORBIT_STATE:-/var/lib/orbitdrive}
HEALTH=${ORBIT_HEALTH_URL:-http://127.0.0.1:8080}
mkdir -p "$STATE/public"
version=$(curl -fsS -m 5 "$HEALTH/v1/meta" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)
mem=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
swap=$(awk '/SwapFree/ {print int($2/1024)}' /proc/meminfo)
disk=$(df --output=pcent / | tail -1 | tr -dc 0-9)
iface=""; command -v ip >/dev/null && iface=$(ip route show default 2>/dev/null | awk '{print $5; exit}' || true)
tx=$(cat "/sys/class/net/${iface:-lo}/statistics/tx_bytes" 2>/dev/null || echo 0)
month=$(date -u +%Y-%m)
# Monthly egress: accumulate counter deltas (the kernel counter resets on reboot).
read -r saved_month saved_total saved_last < <(cat "$STATE/egress" 2>/dev/null || echo "$month 0 $tx")
[ "$saved_month" = "$month" ] || saved_total=0
delta=$(( tx >= saved_last ? tx - saved_last : tx ))
total=$(( saved_total + delta ))
echo "$month $total $tx" >"$STATE/egress"
egress_gb=$(( total / 1073741824 ))
alerts=()
[ -n "$version" ] || alerts+=("gateway_down")
[ "$mem" -ge "${ORBIT_MIN_MEM_MB:-60}" ] || alerts+=("low_memory")
[ "$disk" -lt "${ORBIT_WARN_DISK_PCT:-80}" ] || alerts+=("disk_filling")
[ "$egress_gb" -lt "${ORBIT_WARN_EGRESS_GB:-8000}" ] || alerts+=("egress_near_free_limit")   # Always Free: 10 TB/month
last=$(tail -1 /var/log/orbitdrive/deploy.log 2>/dev/null | jq -r '.action // empty' 2>/dev/null || true)
case "$last" in rollback_failed|failed) alerts+=("deploy_$last");; rolled_back) alerts+=("release_rolled_back");; esac
# A billing file the relay could not read is moved aside, and ordering stays closed until the owner looks at it (the console overview says so too).
compgen -G "${ORBIT_DATA_DIR:-/var/lib/orbitdrive-gateway}/billing.json.damaged-*" >/dev/null 2>&1 && alerts+=("billing_data_damaged")
# ---- Log digest: what the gateway itself says went wrong in the last few minutes. Counts, route templates and exception TYPE names only -
# never message text, ids, addresses or file names, so the public copy stays free of anything private.
WINDOW=${ORBIT_LOG_WINDOW_MIN:-5}
logs_all()  { if [ -n "${ORBIT_LOG_ALL_FILE:-}" ]; then cat "$ORBIT_LOG_ALL_FILE" 2>/dev/null || true; else journalctl -u orbitdrive-gateway --since "-${WINDOW}min" -o cat --no-pager 2>/dev/null || true; fi; }
logs_warn() { if [ -n "${ORBIT_LOG_WARN_FILE:-}" ]; then cat "$ORBIT_LOG_WARN_FILE" 2>/dev/null || true; else journalctl -u orbitdrive-gateway --since "-${WINDOW}min" -p warning -o cat --no-pager 2>/dev/null || true; fi; }
requests=$(logs_all | grep -E '^[[:space:]]*(GET|POST|PUT|PATCH|DELETE|HEAD) [^ ]+ -> [0-9]{3} in [0-9]+ ms' || true)
count_status() { grep -cE " -> $1 in " <<<"$requests" || true; }
total=$(grep -c . <<<"$requests" || true); s5=$(count_status '5[0-9]{2}'); s429=$(count_status '429'); s4auth=$(count_status '40[13]')
# Connections that are SUPPOSED to stay open (a PC's control socket, file streams) would make every day look slow, so they are left out of the slowest-request figure.
slowest=$(grep -vE ' /v1/(agent-control|downloads/|agent-downlinks/|agent-streams/)' <<<"$requests" | grep -oE 'in [0-9]+ ms' | grep -oE '[0-9]+' | sort -n | tail -1 || true)
warn_lines=$(logs_warn | grep -c . || true)
fail_lines=$(logs_warn | grep -cE '^(fail|crit):|Unhandled exception' || true)
top_routes=$(grep -E " -> 5[0-9]{2} in " <<<"$requests" | sed -E 's/^[[:space:]]*([A-Z]+ [^ ]+) -> .*/\1/' | sort | uniq -c | sort -rn | head -5 | awk '{c=$1; $1=""; sub(/^ /,""); printf "%s{\"route\":\"%s\",\"count\":%d}", (n++?",":""), $0, c}' || true)
top_exceptions=$(logs_warn | grep -oE '[A-Z][A-Za-z0-9]*(\.[A-Z][A-Za-z0-9]*)*Exception' | sort | uniq -c | sort -rn | head -5 | awk '{printf "%s{\"type\":\"%s\",\"count\":%d}", (n++?",":""), $2, $1}' || true)
restarts=$(systemctl show orbitdrive-gateway -p NRestarts --value 2>/dev/null || echo 0); restarts=${restarts:-0}
[ "$s5" -lt "${ORBIT_WARN_5XX:-5}" ] || alerts+=("http_5xx_spike")
[ "$fail_lines" -lt "${ORBIT_WARN_ERRORS:-3}" ] || alerts+=("gateway_errors")
[ "$s429" -lt "${ORBIT_WARN_429:-200}" ] || alerts+=("rate_limit_flood")
[ "$s4auth" -lt "${ORBIT_WARN_AUTH:-100}" ] || alerts+=("auth_failures_spike")
read -r saved_restarts < <(cat "$STATE/restarts" 2>/dev/null || echo "$restarts"); echo "$restarts" >"$STATE/restarts"
[ "$restarts" -le "$saved_restarts" ] || alerts+=("gateway_restarted")
# ---- Rolling 24 hours: GitHub runs its outside check only a few times a day, so the host keeps its own memory of the last day (one tiny sample per run, counts only)
# and an outside reader sees what happened BETWEEN checks, not just the last few minutes.
SAMPLES="$STATE/log-samples.jsonl"
delta=$(( restarts > saved_restarts ? restarts - saved_restarts : 0 ))
jq -nc --arg t "$(date -u +%FT%TZ)" --argjson requests "$total" --argjson s5 "$s5" --argjson s429 "$s429" --argjson s4 "$s4auth" --argjson slow "${slowest:-0}" \
  --argjson warn "$warn_lines" --argjson err "$fail_lines" --argjson restarts "$delta" --arg alerts "${alerts[*]:-}" \
  '{t:$t,requests:$requests,status5xx:$s5,status429:$s429,status401403:$s4,slowestMs:$slow,warningLines:$warn,errorLines:$err,gatewayRestarts:$restarts,alerts:($alerts|split(" ")|map(select(length>0)))}' >>"$SAMPLES"
tail -n 288 "$SAMPLES" >"$SAMPLES.tmp" && mv "$SAMPLES.tmp" "$SAMPLES"
last24h=$(jq -sc '{samples:length, requests:(map(.requests)|add), status5xx:(map(.status5xx)|add), status429:(map(.status429)|add), status401403:(map(.status401403)|add),
  slowestMs:(map(.slowestMs)|max), warningLines:(map(.warningLines)|add), errorLines:(map(.errorLines)|add), gatewayRestarts:(map(.gatewayRestarts)|add),
  firstSample:(.[0].t), recentAlerts:(map(.alerts[])|unique)}' "$SAMPLES")
jq -n --arg time "$(date -u +%FT%TZ)" --arg version "$version" --argjson mem "$mem" --argjson swap "$swap" --argjson disk "$disk" \
  --argjson egress "$egress_gb" --arg alerts "${alerts[*]:-}" \
  --argjson last24h "$last24h" --argjson logs "{\"windowMin\":$WINDOW,\"requests\":$total,\"status5xx\":$s5,\"status429\":$s429,\"status401403\":$s4auth,\"slowestMs\":${slowest:-0},\"warningLines\":$warn_lines,\"errorLines\":$fail_lines,\"gatewayRestarts\":$restarts,\"topFailingRoutes\":[$top_routes],\"topExceptions\":[$top_exceptions]}" \
  '{time:$time, version:$version, memAvailableMb:$mem, swapFreeMb:$swap, diskUsedPct:$disk, egressGbThisMonth:$egress, logs:$logs, last24h:$last24h, alerts:($alerts|split(" ")|map(select(length>0)))}' \
  >"$STATE/public/status.json.tmp"
mv "$STATE/public/status.json.tmp" "$STATE/public/status.json"
