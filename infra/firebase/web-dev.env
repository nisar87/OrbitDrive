# PUBLIC web configuration for the development site (Firebase web API keys are public identifiers, not secrets; access is enforced by
# Firebase Auth and the relay). Used by scripts/deploy-web.mjs when apps/web/.env.local does not exist (CI). The relay address comes from
# infra/relay/environments/dev.json: if Oracle gives the relay a new IP, update both and redeploy.
VITE_GATEWAY_URL=https://relay.myorbitdrive.app
VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=AIzaSyBLxTGTEiIKsNEqB0AFeekCqOPKrNtOxFQ
VITE_FIREBASE_AUTH_DOMAIN=orbitdrive-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orbitdrive-dev
VITE_FIREBASE_APP_ID=1:821727049510:web:ffdbc2b2c43bdfe47d73e7
